# Copia questo file come ".env" e compila i valori.

# Google Cloud Console -> API e servizi -> Credenziali -> Crea chiave API
# (abilita prima "YouTube Data API v3")
YOUTUBE_API_KEY=

# Link o ID della playlist YouTube (deve essere Pubblica o Non in elenco)
YOUTUBE_PLAYLIST=https://www.youtube.com/playlist?list=...

# https://developer.spotify.com/dashboard -> Create app
# Redirect URI da inserire nell'app: http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Nome della playlist che verrà creata su Spotify
SPOTIFY_PLAYLIST_NAME=Da YouTube

# Paese dell'account Spotify (serve per cercare i podcast)
SPOTIFY_MARKET=IT

# Video non musicali più lunghi di così (minuti) = episodio completo; più corti = clip
DURATA_MIN_EPISODIO_MIN=20
